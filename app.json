{
  "expo": {
    "name": "Nexset",
    "slug": "nexset",
    "description": "本地优先的跨平台健身计划、训练记录与可选 AI 教练应用。",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexset",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.nexset",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "NSLocalNetworkUsageDescription": "Nexset 需要访问局域网中的 WebDAV 服务器，以同步训练数据。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.anonymous.nexset"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.nexset"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Nexset 读取你选择的器材图片或视频，以便识别健身房器材。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.anonymous.nexset.widgets",
          "groupIdentifier": "group.com.anonymous.nexset",
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "NexsetWorkoutWidget",
              "displayName": "Nexset 训练",
              "description": "开始训练，并在训练中查看当前动作和完成进度。",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Nexset 读取你的体重、体脂、心率和训练记录，用于同步训练数据与趋势。",
          "NSHealthUpdateUsageDescription": "Nexset 将你完成的训练和身体数据写入 Apple 健康。",
          "background": true
        }
      ],
      "./plugins/with-http-cleartext",
      "@bacons/apple-targets",
      "expo-build-properties",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "native"
        ]
      }
    }
  }
}
